<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Expediente de Investigación - Caso Noir</title>
    <style>
        /* ==========================================
           ESTILO NOIR: EXPEDIENTE POLICIAL DE DETECTIVE
           ========================================== */
        @import url('https://fonts.googleapis.com/css2?family=Courier+Prime:ital,wght@0,400;0,700;1,400&family=Special+Elite&display=swap');

        body {
            background-color: #12100e;
            background-image: radial-gradient(#261e14 15%, transparent 16%), radial-gradient(#1c1610 15%, transparent 16%);
            background-size: 60px 60px;
            background-position: 0 0, 30px 30px;
            color: #2b231d;
            font-family: 'Courier Prime', monospace;
            padding: 20px;
            margin: 0;
            display: flex;
            justify-content: center;
        }

        .container {
            width: 100%;
            max-width: 750px;
        }

        /* Carpeta / Expediente Policial */
        #menu, #dia, #periodico, #interrogatorio, #minijuego, #objetivos, #final {
            background: #e3d2b5;
            background-image: linear-gradient(to bottom, #ebd9be 0%, #d6c19f 100%);
            border: 2px solid #8c6f47;
            border-radius: 4px;
            padding: 35px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.8), inset 0 0 80px rgba(120, 80, 30, 0.15);
            position: relative;
            box-sizing: border-box;
            margin-bottom: 20px;
        }

        /* Sello CLASIFICADO en el expediente */
        #menu::before, #dia::before, #periodico::before, #interrogatorio::before, #minijuego::before, #objetivos::before {
            content: "CONFIDENCIAL";
            position: absolute;
            top: 15px;
            right: 20px;
            font-family: 'Special Elite', cursive;
            color: rgba(160, 30, 30, 0.35);
            font-size: 20px;
            border: 3px dashed rgba(160, 30, 30, 0.35);
            padding: 4px 12px;
            transform: rotate(-5deg);
            pointer-events: none;
        }

        h1, h2, h3 {
            font-family: 'Special Elite', cursive;
            color: #3b2413;
            text-transform: uppercase;
            letter-spacing: 1px;
            border-bottom: 2px solid #a88b63;
            padding-bottom: 8px;
            margin-top: 0;
        }

        p {
            line-height: 1.6;
            font-size: 15px;
        }

        .pista, .periodico, .sospechoso {
            background: #f4ead5;
            border-left: 5px solid #a63a24;
            padding: 15px;
            margin: 15px 0;
            font-size: 15px;
            box-shadow: inset 0 0 5px rgba(0,0,0,0.1);
            border-radius: 2px;
        }

        button {
            background: #3a2e2b;
            color: #f4ead5;
            font-family: 'Courier Prime', monospace;
            font-weight: bold;
            border: 1px solid #1a120e;
            padding: 12px 20px;
            margin: 6px 0;
            cursor: pointer;
            border-radius: 2px;
            box-shadow: 2px 3px 5px rgba(0,0,0,0.4);
            transition: all 0.2s ease;
            width: 100%;
            box-sizing: border-box;
            font-size: 14px;
        }

        button:hover {
            background: #59443f;
            transform: translateY(-2px);
        }

        button:disabled {
            background: #8a817a !important;
            color: #d1c7bd !important;
            cursor: not-allowed;
            box-shadow: none;
            transform: none;
            border-color: #666;
        }

        select, input[type="text"] {
            background: #fdfbf7;
            border: 1px solid #7c6548;
            font-family: 'Courier Prime', monospace;
            padding: 10px;
            margin: 8px 0;
            width: 100%;
            box-sizing: border-box;
            font-size: 14px;
            color: #2b231d;
        }

        .botonPista {
            width: 45px; 
            height: 45px; 
            font-size: 18px; 
            margin: 3px; 
            display: inline-block;
            text-align: center;
            padding: 0;
        }

        .ganar { color: #1e5e29; border-bottom-color: #1e5e29; }
        .perder { color: #8a1c1c; border-bottom-color: #8a1c1c; }
    </style>
</head>
<body>
    <div class="container">
        <!-- PANTALLAS -->
        <div id="menu">
            <h1>🕵️ EXPEDIENTE DE INVESTIGACIÓN</h1>
            <p>Don Alejandro ha sido víctima de un crimen. Cada investigación es única: las pruebas, motivos y el culpable cambiarán en cada caso.</p>
            <button onclick="iniciar()">📁 Abrir Nuevo Expediente</button>
        </div>

        <div id="dia" style="display:none;"></div>
        <div id="periodico" style="display:none;"></div>
        <div id="interrogatorio" style="display:none;"></div>
        <div id="minijuego" style="display:none;"></div>
        <div id="objetivos" style="display:none;"></div>
        <div id="final" style="display:none;"></div>
    </div>

    <script>
        // ==========================================
        // VARIABLES GLOBALES Y BANCO DE CULPABLES
        // ==========================================
        let diaActual = 1;
        let preguntasRestantes = 2;
        let interrogatorioCompletado = false;
        let culpableActualKey = ""; 
        let culpableDatos = {};

        // Banderas de minijuegos
        let minijuegoD1 = false;
        let croquisD2 = false;
        let rompecodigoD2 = false;
        let docD3 = false;
        let pistasD3 = false;
        let reconstruccionD3 = false;
        let minijuegoD4_1 = false, minijuegoD4_2 = false, minijuegoD4_3 = false, minijuegoD4_4 = false, minijuegoD4_5 = false;
        let pruebasPresentadas = 0;
        let listaPruebasCompletas = [];

        // BASE DE DATOS DE SOSPECHOSOS Y SUS EVIDENCIAS
        const perfilesCulpables = {
            marta: {
                nombre: "Marta",
                ocupacion: "Artista / Pintora",
                emoji: "🎨",
                quimicoCorrecto: "Solvente de óleo para pintura",
                quimicoDetalle: "🎨 Alguien usó solvente de pintura para disimular la sustancia",
                documentoCorrecto: "La anulación del testamento en favor de Marta",
                huellaCorrecta: "🎨 Marta (Talla 37 con manchas de óleo en la punta)",
                motivo: "Conflicto económico por la herencia anulada",
                pruebaLlave: "solvente"
            },
            carlos: {
                nombre: "Carlos",
                ocupacion: "Agricultor",
                emoji: "🌾",
                quimicoCorrecto: "Pesticida agrícola concentrado",
                quimicoDetalle: "👨‍🌾 Contiene trazas de un pesticida de uso estrictamente agrícola",
                documentoCorrecto: "El contrato de embargo sobre las tierras de Carlos",
                huellaCorrecta: "👨‍🌾 Carlos (Botas pesadas Talla 42 con barro de cultivo)",
                motivo: "Deuda millonaria y despojo de sus tierras agrícolas",
                pruebaLlave: "pesticida"
            },
            ana: {
                nombre: "Ana",
                ocupacion: "Enfermera",
                emoji: "🏥",
                quimicoCorrecto: "Sedante potente de uso hospitalario",
                quimicoDetalle: "💉 Sustancia de distribución restringida en clínicas",
                documentoCorrecto: "El reporte de negligencia médica firmado por Don Alejandro",
                huellaCorrecta: "🏥 Ana (Zapatos clínicos suela blanca Talla 36)",
                motivo: "Encubrir una negligencia médica que arruinaría su carrera",
                pruebaLlave: "sedante"
            },
            luis: {
                nombre: "Luis",
                ocupacion: "Profesor",
                emoji: "🏫",
                quimicoCorrecto: "Reactivo químico de laboratorio escolar",
                quimicoDetalle: "🧪 Compuesto utilizado habitualmente en experimentos de química",
                documentoCorrecto: "Las cartas de chantaje dirigidas a la academia de Luis",
                huellaCorrecta: "🏫 Luis (Mocasines de vestir Talla 40 gastados)",
                motivo: "Evitar que salieran a la luz cartas de chantaje escolar",
                pruebaLlave: "reactivo"
            }
        };

        // NOTICIAS DEL PERIÓDICO
        const periodicos = {
            1: "Tragedia en la Mansión: Don Alejandro fue hallado en su despacho. Las autoridades inician el peritaje en la escena.",
            2: "El expediente del caso revela que varias personas cercanas tenían conflictos financieros recientes con la víctima.",
            3: "Grave hallazgo: Se confirma que la escena fue alterada deliberadamente antes de la llegada de la policía.",
            4: "Muestras de laboratorio e inspección detallada del despacho revelan contradicciones irrefutables.",
            5: "El Gran Juicio Final: La fiscalía exige presentar las 3 pruebas definitivas para dictar sentencia."
        };
// ==========================================
        // FUNCIONES DE NAVEGACIÓN Y PANTALLAS
        // ==========================================
        function mostrar(id) {
            document.querySelectorAll("#menu,#dia,#periodico,#interrogatorio,#minijuego,#objetivos,#final").forEach(
                pantalla => pantalla.style.display = "none"
            );
            document.getElementById(id).style.display = "block";
        }

        function iniciar() {
            diaActual = 1;
            interrogatorioCompletado = false;
            
            // ELECCIÓN ALEATORIA DEL CULPABLE AL INICIAR NUEVA PARTIDA
            const llaves = Object.keys(perfilesCulpables);
            culpableActualKey = llaves[Math.floor(Math.random() * llaves.length)];
            culpableDatos = perfilesCulpables[culpableActualKey];

            // Reiniciar banderas de minijuegos
            minijuegoD1 = false;
            croquisD2 = false;
            rompecodigoD2 = false;
            docD3 = false;
            pistasD3 = false;
            reconstruccionD3 = false;
            minijuegoD4_1 = false; minijuegoD4_2 = false; minijuegoD4_3 = false; minijuegoD4_4 = false; minijuegoD4_5 = false;
            pruebasPresentadas = 0;

            mostrar("dia");
            document.getElementById("dia").innerHTML = `
                <h1>Día ${diaActual}</h1>
                <p>Comienza una nueva jornada de investigación. Abre el diario para conocer los reportes de la jornada.</p>
                <button onclick="verPeriodico()">📰 Leer Diario de la Ciudad</button>
            `;
        }

        function verPeriodico() {
            mostrar("periodico");
            let botonesMinijuegos = "";

            if (diaActual === 1) {
                botonesMinijuegos = `<button onclick="iniciarMinijuego()">${minijuegoD1 ? '✅' : '🔎'} Inspeccionar Escena del Crimen (Día 1)</button>`;
            } else if (diaActual === 2) {
                botonesMinijuegos = `
                    <button onclick="iniciarCroquis()">${croquisD2 ? '✅' : '🗺️'} Analizar Croquis de Ubicaciones (Día 2)</button>
                    <button onclick="iniciarRompecodigo()">${rompecodigoD2 ? '✅' : '🔐'} Descifrar Nota Cifrada (Día 2)</button>
                `;
            } else if (diaActual === 3) {
                botonesMinijuegos = `
                    <button onclick="iniciarDocumentos()">${docD3 ? '✅' : '📄'} Analizar Inconsistencia en Documentos (Día 3)</button>
                    <button onclick="iniciarBuscarPistas()">${pistasD3 ? '✅' : '🔎'} Registrar Habitación Principal (Día 3)</button>
                    <button onclick="iniciarReconstruccion()">${reconstruccionD3 ? '✅' : '🕵️'} Reconstruir Secuencia Temporal (Día 3)</button>
                `;
            } else if (diaActual === 4) {
                botonesMinijuegos = `
                    <button onclick="iniciarD4_Minijuego1()">${minijuegoD4_1 ? '✅' : '🧪'} 1. Análisis Químico de Laboratorio</button>
                    <button onclick="iniciarD4_Minijuego2()">${minijuegoD4_2 ? '✅' : '📊'} 2. Auditoría de Bitácora Digital</button>
                    <button onclick="iniciarD4_Minijuego3()">${minijuegoD4_3 ? '✅' : '🧩'} 3. Ensamblar Documento Triturado</button>
                    <button onclick="iniciarD4_Minijuego4()">${minijuegoD4_4 ? '✅' : '👣'} 4. Peritaje de Huella de Calzado</button>
                    <button onclick="iniciarD4_Minijuego5()">${minijuegoD4_5 ? '✅' : '🗝️'} 5. Inspección de Cerradura</button>
                `;
            } else if (diaActual === 5) {
                botonesMinijuegos = `
                    <button onclick="iniciarJuicioFinal()">⚖️ INGRESAR A LA AUDIENCIA DE JUICIO (Día 5)</button>
                `;
            }

            document.getElementById("periodico").innerHTML = `
                <div class="periodico">
                    <h2>📰 El Diario de la Ciudad (Día ${diaActual})</h2>
                    <p>${periodicos[diaActual]}</p>
                    <hr>
                    ${diaActual < 5 ? `<button onclick="interrogar()">${interrogatorioCompletado ? '✅' : '🕵️'} Tomar Declaraciones (Interrogatorio)</button><br>` : ''}
                    ${botonesMinijuegos}
                    <hr>
                    <button onclick="mostrarObjetivos()">📋 Revisar Objetivos del Expediente</button>
                </div>
            `;
        }

        // ==========================================
        // BASE DE DATOS Y SISTEMA DE INTERROGATORIOS
        // ==========================================
        const listaSospechososBase = [
            { id: "marta", nombre: "Marta", emoji: "🎨", pregunta: "¿Dónde estuviste la noche del incidente?", respuesta: "Estuve trabajando en mi taller de pintura cerca de la propiedad." },
            { id: "carlos", nombre: "Carlos", emoji: "🌾", pregunta: "¿Qué relación tenías con Don Alejandro?", respuesta: "Administro sus tierras. Tuvimos discusiones financieras, pero nada grave." },
            { id: "ana", nombre: "Ana", emoji: "🏥", pregunta: "¿Suministraste algún medicamento?", respuesta: "Le entregué sus medicamentos habituales de rutina por la tarde." },
            { id: "luis", nombre: "Luis", emoji: "🏫", pregunta: "¿A qué hora saliste del lugar?", respuesta: "Salí antes del anochecer tras revisar unos documentos académicos." }
        ];

        function interrogar() {
            preguntasRestantes = 2;
            mostrar("interrogatorio");
            let html = `
                <h1>🕵️ Interrogatorio (Día ${diaActual})</h1>
                <h3>Preguntas permitidas hoy: <span id="contador">2</span></h3>
                <p>Selecciona a un sospechoso para revisar su declaración formal.</p>
            `;

            listaSospechososBase.forEach((p, index) => {
                html += `
                    <div class="sospechoso">
                        <span>${p.emoji}</span>
                        <h2>${p.nombre}</h2>
                        <button onclick="preguntar(${index})">Interrogar a ${p.nombre}</button>
                    </div>
                `;
            });

            html += `<br><button onclick="verPeriodico()">📰 Volver al expediente</button>`;
            document.getElementById("interrogatorio").innerHTML = html;
        }

        function preguntar(index) {
            if (preguntasRestantes <= 0) {
                alert("Has agotado las preguntas permitidas para esta jornada.");
                return;
            }

            let persona = listaSospechososBase[index];

            alert(
                "Declaración tomada a: " + persona.nombre +
                "\n\nPregunta:\n" + persona.pregunta +
                "\n\nRespuesta asentada:\n\"" + persona.respuesta + "\""
            );

            preguntasRestantes--;
            document.getElementById("contador").innerHTML = preguntasRestantes;

            if (preguntasRestantes === 0) {
                interrogatorioCompletado = true;
                alert("📑 Declaraciones del día registradas en el expediente.");
            }
        }

        // ==========================================
        // MINIJUEGO DÍA 1: BUSCA LAS PISTAS
        // ==========================================
        let vidas = 5;
        let pistasEncontradas = 0;
        let posicionesPistas = [3, 7, 11, 15, 19];

        function iniciarMinijuego() {
            vidas = 5;
            pistasEncontradas = 0;
            mostrar("minijuego");

            let html = `
                <div class="minijuego">
                    <h1>🔎 Inspección de Escena (Día 1)</h1>
                    <h3>Intentos restantes: <span id="vidas">❤️❤️❤️❤️❤️</span></h3>
                    <div class="pista">
                        🧩 <strong>Instrucciones del perito:</strong><br><br>
                        "No busques al azar.<br>
                        La primera marca está en el casillero 3 y cada pista está cuatro pasos adelante.<br>
                        Sigue la secuencia matemática para encontrar los indicios."
                    </div>
            `;

            for (let i = 1; i <= 20; i++) {
                html += `<button class="botonPista" onclick="revisarPista(${i}, this)">?</button>`;
            }

            html += `
                    <br><br>
                    <button onclick="verPeriodico()">📰 Volver al expediente</button>
                </div>
            `;
            document.getElementById("minijuego").innerHTML = html;
        }

        function revisarPista(numero, boton) {
            if (boton.disabled) return;
            boton.disabled = true;

            if (posicionesPistas.includes(numero)) {
                pistasEncontradas++;
                boton.innerHTML = "🔎";
                boton.style.borderColor = "#1e5e29";

                if (pistasEncontradas === 5) {
                    minijuegoD1 = true;
                    alert("🧤 ¡Identificaste las 5 marcas dactilares clave!\n\n📄 Conclusión forense:\nQuien estuvo aquí conocía la distribución exacta de la habitación.");
                }
            } else {
                vidas--;
                boton.innerHTML = "❌";
                boton.style.borderColor = "#8a1c1c";
                document.getElementById("vidas").innerHTML = "❤️".repeat(vidas);

                if (vidas === 0) {
                    alert("⚠️ Has agotado tus oportunidades. Reinicia la inspección.");
                    document.querySelectorAll(".botonPista").forEach(btn => btn.disabled = true);
                }
            }
        }

        // ==========================================
        // MINIJUEGOS DÍA 2: CROQUIS Y ROMPECÓDIGO
        // ==========================================
        let codigoSecreto = "14,21,14,3,1 / 20,21,22,15 / 16,18,15,2,12,5,13,1,19";

        function iniciarRompecodigo() {
            mostrar("minijuego");
            document.getElementById("minijuego").innerHTML = `
                <div class="minijuego">
                    <h1>🔐 Descifrado de Nota (Día 2)</h1>
                    <p>Encontraste un texto cifrado dentro de un libro de cuentas.</p>
                    <h3>Código numérico:</h3>
                    <div class="pista">${codigoSecreto}</div>
                    <p>Usa la clave numérico-alfabética:<br><strong>A = 1, B = 2, C = 3...</strong></p>
                    <input type="text" id="respuestaCodigo" placeholder="Escribe el mensaje descifrado en mayúsculas">
                    <br>
                    <button onclick="comprobarCodigo()">🔎 Validar Descifrado</button>
                    <br><br>
                    <button onclick="verPeriodico()">📰 Volver al expediente</button>
                </div>
            `;
        }

        function comprobarCodigo() {
            let respuesta = document.getElementById("respuestaCodigo").value.toUpperCase().trim();
            if (respuesta === "NUNCA TUVO PROBLEMAS") {
                rompecodigoD2 = true;
                alert("✅ ¡Traducción correcta!\n\n📄 Nota asentada:\nEl documento asegura falsamente que no existían fricciones con la víctima.");
            } else {
                alert("❌ Traducción incorrecta. Revisa la equivalencia de cada número con el alfabeto.");
            }
        }

        function iniciarCroquis() {
            mostrar("minijuego");
            document.getElementById("minijuego").innerHTML = `
                <div class="minijuego">
                    <h1>🗺️ Análisis de Croquis (Día 2)</h1>
                    <p>Evalúa la distancia de las residencias con respecto a la casa de la víctima.</p>
                    <div class="pista">
                        🏠 <strong>Residencia Principal (Centro)</strong><br><br>
                        🌾 Carlos: 5 km<br>
                        🏥 Ana: 5 km<br>
                        🏫 Luis: 8 km<br>
                        🎨 Marta: 3 km
                    </div>
                    <h3>¿Quién se ubicaba a menor distancia?</h3>
                    <button onclick="respuestaCroquis('Carlos')">🌾 Carlos</button>
                    <button onclick="respuestaCroquis('Ana')">🏥 Ana</button>
                    <button onclick="respuestaCroquis('Luis')">🏫 Luis</button>
                    <button onclick="respuestaCroquis('Marta')">🎨 Marta</button>
                    <br><br>
                    <button onclick="verPeriodico()">📰 Volver al expediente</button>
                </div>
            `;
        }

        function respuestaCroquis(respuesta) {
            if (respuesta === "Marta") {
                croquisD2 = true;
                alert("✅ Ubicación verificada.\n\n📄 Registro:\nMarta contaba con la mayor cercanía geográfica a la escena.");
            } else {
                alert("❌ Esa distancia no corresponde a la menor medida del croquis.");
            }
        }

        // ==========================================
        // MINIJUEGOS DÍA 3
        // ==========================================
        function iniciarDocumentos() {
            mostrar("minijuego");
            document.getElementById("minijuego").innerHTML = `
                <div class="minijuego">
                    <h1>📄 Inconsistencia Documental (Día 3)</h1>
                    <p>Analiza el siguiente testimonio asentado por escrito.</p>
                    <div class="pista">
                        📑 <strong>Ficha del archivo:</strong><br><br>
                        "Aseguro haber estado reunido con la víctima en su despacho el 15 de marzo."<br><br>
                        <em>[Sello oficial: Documento timbrado el 10 de marzo]</em>
                    </div>
                    <h3>¿Qué anomalía presenta el documento?</h3>
                    <button onclick="revisarDocumento('fecha')">📅 Incoherencia de fechas (Firmado antes de lo ocurrido)</button>
                    <button onclick="revisarDocumento('nombre')">👤 Suplantación de identidad en la firma</button>
                    <button onclick="revisarDocumento('falsa')">❌ El tipo de papel no es oficial</button>
                    <br><br>
                    <button onclick="verPeriodico()">📰 Volver al expediente</button>
                </div>
            `;
        }

        function revisarDocumento(respuesta) {
            if (respuesta === "fecha") {
                docD3 = true;
                alert("✅ Inconsistencia confirmada.\n\n📄 Informe:\nEl documento fue fechado de forma fraudulenta para fabricar una coartada.");
            } else {
                alert("❌ Anomalía no detectada. Compara la fecha declarada con la fecha de timbrado.");
            }
        }

        let ordenCorrecto = [3, 4, 2, 1];
        let ordenJugador = [];

        function iniciarReconstruccion() {
            ordenJugador = [];
            mostrar("minijuego");
            document.getElementById("minijuego").innerHTML = `
                <div class="minijuego">
                    <h1>🕵️ Secuencia Cronológica (Día 3)</h1>
                    <p>Organiza la sucesión de hechos seleccionando los eventos en orden.</p>
                    <div class="pista">
                        <button onclick="ordenEscena(1)">🧩 Intento de alteración de evidencias</button><br>
                        <button onclick="ordenEscena(2)">🧩 Ocurrencia del hecho principal</button><br>
                        <button onclick="ordenEscena(3)">🧩 Ingreso de la víctima a la oficina</button><br>
                        <button onclick="ordenEscena(4)">🧩 Acceso no autorizado a la propiedad</button>
                    </div>
                    <p id="orden"><strong>Secuencia actual:</strong> NINGUNA</p>
                    <button onclick="verPeriodico()">📰 Volver al expediente</button>
                </div>
            `;
        }

        function ordenEscena(numero) {
            ordenJugador.push(numero);
            document.getElementById("orden").innerHTML = "<strong>Secuencia actual:</strong> " + ordenJugador.join(" ➔ ");

            if (ordenJugador.length === 4) {
                if (JSON.stringify(ordenJugador) === JSON.stringify(ordenCorrecto)) {
                    reconstruccionD3 = true;
                    alert("✅ Cronología validada.\n\n📄 Registro:\nLa reconstrucción fija la línea de tiempo exacta de los hechos.");
                } else {
                    alert("❌ La secuencia no guarda orden lógico. Reiniciando lista.");
                    ordenJugador = [];
                    document.getElementById("orden").innerHTML = "<strong>Secuencia actual:</strong> NINGUNA";
                }
            }
        }

