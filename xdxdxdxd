        // ==========================================
        // DÍA 5: JUICIO FINAL CON PRUEBAS BARAJADAS
        // ==========================================
        function iniciarJuicioFinal() {
            pruebasPresentadas = 0;
            listaPruebasCompletas = [];
            mostrar("minijuego");

            // Crear y barajar las 5 pruebas de la partida actual
            let evidenciaPool = [
                { id: culpableDatos.pruebaLlave, texto: `🧪 Sustancia: ${culpableDatos.quimicoCorrecto}` },
                { id: 'docMotivo', texto: `📄 Documento: ${culpableDatos.documentoCorrecto}` },
                { id: 'huellaCulpable', texto: `👣 Huella: ${culpableDatos.huellaCorrecta}` },
                { id: 'falsa1', texto: `🌾 Herraje oxidado de procedencia dudosa` },
                { id: 'falsa2', texto: `🏫 Factura antigua de un local ajeno` }
            ];
            
            let evidenciaBarajada = barajarArray(evidenciaPool);

            document.getElementById("minijuego").innerHTML = `
                <div class="minijuego">
                    <h1>⚖️ El Juicio Final: Presentación de Pruebas</h1>
                    <p>Selecciona las 3 evidencias determinantes antes de dictar la acusación final.</p>
                    <div class="pista" id="estadoPruebas">
                        Pruebas presentadas: <strong>0 / 3</strong>
                    </div>
                    
                    <h3>Evidencias disponibles en el expediente:</h3>
                    ${evidenciaBarajada.map((ev, index) => `
                        <button id="p${index}" onclick="seleccionarPrueba('${ev.id}', 'p${index}')">${ev.texto}</button><br>
                    `).join('')}
                    
                    <hr>
                    <h3>Sostener acusación formal contra:</h3>
                    <select id="acusadoSelect">
                        <option value="marta">🎨 Marta (Artista)</option>
                        <option value="carlos">🌾 Carlos (Agricultor)</option>
                        <option value="ana">🏥 Ana (Enfermera)</option>
                        <option value="luis">🏫 Luis (Profesor)</option>
                    </select>

                    <button id="btnAcusar" onclick="evaluarJuicio()" style="display:none; background:#8a1c1c; color:#fff;">👨‍⚖️ Emitir Veredicto Final</button>
                    <br><br>
                    <button onclick="verPeriodico()">📰 Volver al expediente</button>
                </div>
            `;
        }

        function seleccionarPrueba(idPrueba, idBoton) {
            if (listaPruebasCompletas.includes(idPrueba)) return;

            listaPruebasCompletas.push(idPrueba);
            document.getElementById(idBoton).disabled = true;
            
            pruebasPresentadas++;
            document.getElementById("estadoPruebas").innerHTML = `Pruebas presentadas: <strong>${pruebasPresentadas} / 3</strong>`;

            if (pruebasPresentadas === 3) {
                document.getElementById("btnAcusar").style.display = "block";
            }
        }

        function evaluarJuicio() {
            let acusadoSeleccionado = document.getElementById("acusadoSelect").value;
            
            let pruebasCorrectas = listaPruebasCompletas.includes(culpableDatos.pruebaLlave) && 
                                   listaPruebasCompletas.includes('docMotivo') && 
                                   listaPruebasCompletas.includes('huellaCulpable');

            let sospechosoCorrecto = (acusadoSeleccionado === culpableActualKey);

            mostrar("final");
            if (pruebasCorrectas && sospechosoCorrecto) {
                document.getElementById("final").innerHTML = `
                    <h1 class="ganar">🎉 ¡CASO RESUELTO CON ÉXITO!</h1>
                    <h2>${culpableDatos.nombre} (${culpableDatos.ocupacion}) ha sido declarado(a) CULPABLE</h2>
                    <p>Has presentado la evidencia incriminatoria correcta ante el tribunal:</p>
                    <div class="pista">
                        1. ${culpableDatos.quimicoCorrecto}<br>
                        2. ${culpableDatos.documentoCorrecto}<br>
                        3. ${culpableDatos.huellaCorrecta}
                    </div>
                    <p>¡Gran trabajo de deducción, Detective! El expediente ha sido cerrado con éxito.</p>
                    <br>
                    <button onclick="iniciar()">🔄 Abrir Un Nuevo Expediente (Nuevo Culpable)</button>
                `;
            } else {
                document.getElementById("final").innerHTML = `
                    <h1 class="perder">❌ VEREDICTO INCORRECTO</h1>
                    <h2>El tribunal ha desestimado la acusación</h2>
                    <p>Las pruebas no fueron contundentes o acusaste a la persona equivocada. El verdadero responsable era <strong>${culpableDatos.nombre}</strong>.</p>
                    <br>
                    <button onclick="iniciar()">🔄 Reiniciar con una nueva investigación</button>
                `;
            }
        }

        // ==========================================
        // CONTROL DE OBJETIVOS Y DÍAS
        // ==========================================
        function mostrarObjetivos() {
            mostrar("objetivos");

            let minijuegosHTML = "";
            if (diaActual === 1) {
                minijuegosHTML = `<p>${minijuegoD1 ? "✅" : "❌"} Inspección de escena completada</p>`;
            } else if (diaActual === 2) {
                minijuegosHTML = `
                    <p>${croquisD2 ? "✅" : "❌"} Croquis analizado</p>
                    <p>${rompecodigoD2 ? "✅" : "❌"} Rompecódigo descifrado</p>
                `;
            } else if (diaActual === 3) {
                minijuegosHTML = `
                    <p>${docD3 ? "✅" : "❌"} Inconsistencia documental (1/3)</p>
                    <p>${pistasD3 ? "✅" : "❌"} Habitación registrada (2/3)</p>
                    <p>${reconstruccionD3 ? "✅" : "❌"} Cronología fijada (3/3)</p>
                `;
            } else if (diaActual === 4) {
                minijuegosHTML = `
                    <p>${minijuegoD4_1 ? "✅" : "❌"} 1. Análisis Químico</p>
                    <p>${minijuegoD4_2 ? "✅" : "❌"} 2. Bitácora Digital</p>
                    <p>${minijuegoD4_3 ? "✅" : "❌"} 3. Reconstruir Papel</p>
                    <p>${minijuegoD4_4 ? "✅" : "❌"} 4. Examen de Huellas</p>
                    <p>${minijuegoD4_5 ? "✅" : "❌"} 5. Cerradura Oficina</p>
                `;
            } else if (diaActual === 5) {
                minijuegosHTML = `<p>⚖️ Audiencia de Juicio Final disponible</p>`;
            }

            document.getElementById("objetivos").innerHTML = `
                <h1>📋 Revisión de Avance (Día ${diaActual})</h1>
                <p>✅ Reporte del diario revisado</p>
                ${minijuegosHTML}
                ${diaActual < 5 ? `<p>${interrogatorioCompletado ? "✅" : "❌"} Declaraciones del día registradas</p>` : ''}
                <hr>
                <h2>✍️ Notas de Sospechosos Principales</h2>
                <input type="text" placeholder="Primer sospechoso"><br>
                <input type="text" placeholder="Segundo sospechoso"><br>
                <input type="text" placeholder="Tercer sospechoso"><br><br>
                <button onclick="comprobarDia()">${diaActual === 5 ? '⚖️ Ir al Juicio Final' : 'Avanzar al Día ' + (diaActual + 1)}</button>
                <br>
                <button onclick="verPeriodico()">📰 Volver al expediente</button>
            `;
        }

        function comprobarDia() {
            let listos = false;

            if (diaActual === 1) {
                listos = minijuegoD1 && interrogatorioCompletado;
            } else if (diaActual === 2) {
                listos = croquisD2 && rompecodigoD2 && interrogatorioCompletado;
            } else if (diaActual === 3) {
                listos = docD3 && pistasD3 && reconstruccionD3 && interrogatorioCompletado;
            } else if (diaActual === 4) {
                listos = minijuegoD4_1 && minijuegoD4_2 && minijuegoD4_3 && minijuegoD4_4 && minijuegoD4_5 && interrogatorioCompletado;
            } else if (diaActual === 5) {
                iniciarJuicioFinal();
                return;
            }

            if (listos) {
                siguienteDia();
            } else {
                alert("⚠️ Aún tienes diligencias pendientes en el expediente de hoy.");
            }
        }

        function siguienteDia() {
            diaActual++;
            interrogatorioCompletado = false;

            mostrar("dia");
            document.getElementById("dia").innerHTML = `
                <h1>Día ${diaActual}</h1>
                <p>Comienza una nueva jornada de investigación criminal.</p>
                <button onclick="verPeriodico()">📰 Abrir el Diario del Día ${diaActual}</button>
            `;
        }
    </script>
